"""Train one 2D-turbulence stepper (Euler-class FNO) with the one-step, free or kappa-nudged window loss; Adam, cosine lr.

  python turb2d/train.py --mode onestep --tag onestep_s0
  python turb2d/train.py --mode kappa --kappa 0.5 --p 10 --tag k0.5_s0 [--init <run>/final.pt --lr 1e-4]

Data are generated once per process from the config (stored snapshots -> 128^2 -> settle -> trajectories) and
cached to <out_root>/turb2d/data/<key>.pt so later runs reuse them. Writes <out_root>/turb2d/<tag>/{log.csv,
final.pt, meta.json}; final.pt = dict(theta, stats, cfg, args).
"""
import argparse
import hashlib
import json
import math
import os
import sys
import time

import torch

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from ks.config import load_cfg
from turb2d.core import FNO, Model, eval_free, loss_kappa, make_data


def lr_at(cfg, k, lr0):
    w, S, lr1 = cfg["warmup"], cfg["steps"], cfg["lr_end"]
    if k < w:
        return lr0 * (k + 1) / w
    x = (k - w) / max(S - w, 1)
    return lr1 + 0.5 * (lr0 - lr1) * (1 + math.cos(math.pi * x))


def data_cached(cfg, dev):
    keys = ["N", "Re", "fkx", "fky", "alpha", "beta", "h", "dt", "h5", "stride", "settle", "seed_train", "seed_test",
            "n_train", "n_test", "p_train", "horizon"]
    key = hashlib.md5(json.dumps({k: cfg[k] for k in keys}, sort_keys=True).encode()).hexdigest()[:10]
    path = os.path.join(cfg["out_root"], "turb2d", "data", f"{key}.pt")
    if os.path.exists(path):
        d = torch.load(path)
        print(f"data from cache {path}", flush=True)
        from turb2d.solver import Turb2D
        d["ks"] = Turb2D(cfg["N"], cfg["Re"], cfg["fkx"], cfg["fky"], cfg["alpha"], cfg["beta"], cfg["h"], dev)
        return d
    t0 = time.time()
    d = make_data(cfg, dev)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    torch.save({k: v for k, v in d.items() if k != "ks"}, path)
    print(f"data generated and cached to {path} ({time.time() - t0:.0f}s)", flush=True)
    return d


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--cfg", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.yaml"))
    ap.add_argument("--mode", required=True, choices=["onestep", "free", "kappa"])
    ap.add_argument("--kappa", type=float, default=None)
    ap.add_argument("--p", type=int, default=None)
    ap.add_argument("--seed", type=int, default=0)
    ap.add_argument("--tag", required=True)
    ap.add_argument("--init", default=None)
    ap.add_argument("--lr", type=float, default=None)
    ap.add_argument("--steps", type=int, default=None)
    ap.add_argument("--set", nargs="*", default=[])
    a = ap.parse_args()
    cfg = load_cfg(a.cfg, a.set)
    if a.steps:
        cfg["steps"] = a.steps
    lr0 = a.lr or cfg["lr"]
    dev = "cuda" if torch.cuda.is_available() else "cpu"
    torch.set_num_threads(cfg["threads"])
    out = os.path.join(cfg["out_root"], "turb2d", a.tag)
    os.makedirs(out, exist_ok=True)
    p = 1 if a.mode == "onestep" else (a.p or cfg["p_train"])
    kap = {"onestep": 1.0, "free": None, "kappa": a.kappa}[a.mode]
    t0 = time.time()
    d = data_cached(cfg, dev)
    dt = d["dt"]
    arch = FNO(cfg["N"], cfg["modes"], cfg["width"], cfg["layers"], dev)
    stats = {k: v.to(dev) for k, v in d["stats"].items()}
    if a.init:
        ck = torch.load(a.init, map_location=dev)
        stats = {k: v.to(dev) for k, v in ck["stats"].items()}
        th = ck["theta"].to(dev).clone().requires_grad_(True)
    else:
        th = arch.init(a.seed, dev).float().requires_grad_(True)
    model = Model(arch, dt, stats)
    opt = torch.optim.Adam([th], lr=lr0)
    uTr, uTe = d["uT_train"], d["uT_test"]                             # cpu float32
    ntr, ptr = uTr.shape[1], uTr.shape[0] - 1
    gen = torch.Generator().manual_seed(1000 * a.seed + 7)
    p_eval = int(round(cfg["T_eval"] / dt))
    Uev = uTe[:p_eval + 1, :cfg["n_eval"]].to(dev)
    print(f"data {tuple(uTr.shape)} test {tuple(uTe.shape)} P={arch.P} dev={dev} ({time.time() - t0:.0f}s); "
          f"mode={a.mode} p={p} kap={kap} lr={lr0} steps={cfg['steps']}", flush=True)

    def log_eval():
        E = torch.cat([eval_free(model, th.detach(), Uev[:, i:i + 64], p_eval) for i in range(0, Uev.shape[1], 64)], 1)
        per = torch.sqrt((E ** 2).mean(0))
        return float(torch.sqrt((E ** 2).mean())), float(per.median())

    log = []
    for k in range(cfg["steps"]):
        lr = lr_at(cfg, k, lr0)
        for gr in opt.param_groups:
            gr["lr"] = lr
        idx = torch.randint(0, ntr, (cfg["batch"],), generator=gen)
        q0 = int(torch.randint(0, ptr - p + 1, (1,), generator=gen))
        U = uTr[q0:q0 + p + 1, idx].to(dev)
        L = loss_kappa(model, th, U, p, kap)
        opt.zero_grad(set_to_none=True)
        L.backward()
        gn = torch.nn.utils.clip_grad_norm_([th], cfg["clip"])
        opt.step()
        if k % cfg["log_every"] == 0 or k == cfg["steps"] - 1:
            r, m = log_eval()
            log.append([k, lr, float(L.detach()), float(gn), r, m])
            print(f"step {k:6d} lr {lr:.2e} loss {float(L.detach()):.3e} |g| {float(gn):.2e} free rms[0,T] {r:.4f} median {m:.4f} ({time.time() - t0:.0f}s)", flush=True)
            if not math.isfinite(float(L.detach())):
                print("non-finite loss, stopping", flush=True)
                break
    thd = th.detach()
    with open(os.path.join(out, "log.csv"), "w") as fh:
        fh.write("step,lr,loss,gradnorm,free_rms_0T,free_median_0T\n")
        for row in log:
            fh.write(",".join(f"{v:.6e}" for v in row) + "\n")
    torch.save(dict(theta=thd.cpu(), stats={k: v.cpu() for k, v in model.c.items()}, cfg=cfg, args=vars(a)), os.path.join(out, "final.pt"))
    final = {}
    with torch.no_grad():
        Ute = uTe[:, :cfg["n_eval"]]
        E = torch.cat([eval_free(model, thd, Ute[:, i:i + 32].to(dev), Ute.shape[0] - 1).cpu() for i in range(0, Ute.shape[1], 32)], 1)
        per = torch.sqrt((E[:p_eval] ** 2).mean(0))
        final["rms_0T"], final["median_0T"], final["q90_0T"] = float(torch.sqrt((E[:p_eval] ** 2).mean())), float(per.median()), float(per.quantile(0.9))
        final["field_rms"] = float(torch.sqrt((Ute[0] ** 2).flatten(-2).mean(-1).mean()))
        final["rms_at"], final["median_at"] = {}, {}
        for T in cfg["long_horizons"]:
            q = int(round(T / dt)) - 1
            final["rms_at"][str(T)] = float(torch.sqrt((E[q] ** 2).mean()))
            final["median_at"][str(T)] = float(E[q].median())
    meta = dict(mode=a.mode, kappa=kap, p=p, seed=a.seed, steps=cfg["steps"], lr=lr0, init=a.init, wall_s=time.time() - t0, final=final)
    with open(os.path.join(out, "meta.json"), "w") as fh:
        json.dump(meta, fh, indent=1)
    print(json.dumps(final, indent=1), flush=True)


if __name__ == "__main__":
    main()
